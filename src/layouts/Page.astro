---
import Base from "./Base.astro";
import LocalNav from "../components/LocalNav.astro";
import { sectionOf } from "../data/site";

interface Props { title: string; docTitle?: string; image?: string; toc?: { depth: number; slug: string; text: string }[]; description?: string; dek?: string; cover?: string; crumbs?: { label: string; href: string }[]; meta?: string; section?: string; wide?: boolean; local?: boolean }
const { title, docTitle, image, toc = [], description, dek, cover, crumbs = [], meta, section, wide = false, local = true } = Astro.props;
const sec = section ?? sectionOf(Astro.url.pathname);
---
<Base title={docTitle ?? title} description={description ?? dek} image={image ?? cover}>
  <div class="wrap">
    <header class="page-head">
      {(crumbs.length > 0 || sec) && (
        <div class="crumb">{crumbs.length ? crumbs.map((c, n) => <>{n > 0 && <span aria-hidden="true">/</span>}<a href={c.href}>{c.label}</a></>) : <span>{sec}</span>}</div>
      )}
      <h1>{title}</h1>
      {dek && <p class="dek">{dek}</p>}
      {meta && <p class="meta">{meta}</p>}
      <slot name="head" />
    </header>
    {cover && <figure class="page-photo"><img src={cover} alt="" /></figure>}
    {Astro.slots.has("aside") ? (
      <div class="with-aside">
        <div class:list={["prose", { wide }]}><slot /></div>
        <aside class="facts"><slot name="aside" /></aside>
      </div>
    ) : local ? (
      <div class="with-local">
        <LocalNav section={sec} toc={toc} />
        <div class:list={["prose", { wide }]}><slot /></div>
      </div>
    ) : (
      <div class:list={["prose", { wide }]}><slot /></div>
    )}
  </div>
</Base>
