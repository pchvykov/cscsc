---
import { nav } from "../data/site";
// Sibling pages in the current section, so visitors arriving deep can move sideways.
const { section } = Astro.props as { section?: string };
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : Astro.url.pathname + "/";
const s = nav.find((x) => x.label === section) ?? nav.find((x) => x.items.some((i) => path.startsWith(i.href) && i.href !== "/"));
---
{s && (
  <nav class="local-nav" aria-label={`${s.label} pages`}>
    <span class="k">{s.label}</span>
    <ul>{s.items.map((i) => <li><a href={i.href} aria-current={path === i.href ? "page" : undefined}>{i.label}</a></li>)}</ul>
  </nav>
)}
