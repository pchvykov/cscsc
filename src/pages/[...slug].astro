---
// Free-standing pages carried over from Notion (About, Research, Learn ...).
import { getCollection, render } from "astro:content";
import Page from "../layouts/Page.astro";
import { titleCase, summarize } from "../lib/text";
import { enhance } from "../lib/enhance";
import { fmtDate } from "../lib/text";

export async function getStaticPaths() {
  const pages = await getCollection("pages", (p) => !p.data.draft && !p.id.includes("_hub") && !p.id.startsWith("_"));
  return pages.map((p) => ({ params: { slug: p.data.path.replace(/^\/|\/$/g, "") || undefined }, props: { entry: p } }));
}
const { entry } = Astro.props;
// The Research page ends with what came out of the work: proceedings, reports and papers.
const outputs = entry.data.path === "/research/" ? (await getCollection("publications")).sort((a, b) => +b.data.date - +a.data.date) : [];
const kindLabel: Record<string, string> = { proceedings: "Proceedings", report: "Report", paper: "Paper", preprint: "Preprint", essay: "Essay" };
const { headings } = await render(entry);
const body = enhance(entry.rendered?.html ?? "", { mapHeadings: true });
// Long pages get an "On this page" list from their top-level headings.
// Only the page's own sections (h2), not the items inside them.
const outline = headings.filter((h) => h.depth === 2);
const toc = !body.hasMap && outline.length >= 3 ? outline.map((h) => ({ ...h, text: h.text.replace(/^[^\p{L}\p{N}]+/u, "") })) : [];
---
<Page title={titleCase(entry.data.title)} cover={entry.data.cover} toc={toc} description={entry.data.description ?? summarize(entry.body)}>
  {entry.data.layout === "glossary" && (
    <>
      <label class="visually-hidden" for="term-q">Filter terms</label>
      <input id="term-q" class="term-filter" type="search" placeholder="Find a term" />
    </>
  )}
  <Fragment set:html={body.html} />
  {outputs.length > 0 && (
    <section id="outputs" class="outputs">
      <h2>Outputs</h2>
      <ul class="rows">
        {outputs.map((o) => (
          <li><div class="when"><b>{kindLabel[o.data.kind]}</b>{fmtDate(o.data.date)}</div>
          <div><h3><a href={o.data.href}>{o.data.title}</a></h3>{o.data.summary && <p>{o.data.summary}</p>}{o.data.authors && <p>{o.data.authors}</p>}</div></li>
        ))}
      </ul>
      <p class="muted">The Honest Science proceedings are in preparation.</p>
    </section>
  )}
  {entry.data.layout === "glossary" && (
    <script is:inline>
      (function () {
        var q = document.getElementById("term-q");
        var h = document.querySelector(".prose h2"); if (h) h.before(q);
        q.addEventListener("input", function () {
          var t = q.value.trim().toLowerCase();
          document.querySelectorAll(".terms > div").forEach(function (d) { d.hidden = t && d.textContent.toLowerCase().indexOf(t) < 0; });
          document.querySelectorAll(".prose h2, .prose h3").forEach(function (h) {
            var el = h.nextElementSibling, any = false;
            while (el && !/^H[23]$/.test(el.tagName)) { if (el.matches(".terms") && [].some.call(el.children, function (c) { return !c.hidden; })) any = true; el = el.nextElementSibling; }
            h.hidden = !!t && !any;
          });
        });
      })();
    </script>
  )}
</Page>
