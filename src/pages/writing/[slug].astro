---
import { getCollection, render } from "astro:content";
import Page from "../../layouts/Page.astro";
import { fmtDate, summarize } from "../../lib/text";
import { enhance } from "../../lib/enhance";

export async function getStaticPaths() {
  return (await getCollection("posts", (p) => !p.data.draft)).map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const body = enhance(p.rendered?.html ?? "").html;
const people = await getCollection("people");
const authors = p.data.authors.map((id) => people.find((x) => x.id === id)).filter(Boolean);
const all = (await getCollection("posts", (x) => !x.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const i = all.findIndex((x) => x.id === p.id);
const newer = all[i - 1], older = all[i + 1];
const meta = [fmtDate(p.data.date, { day: "numeric", month: "long", year: "numeric" }), authors.map((a) => a!.data.name).join(", "), p.data.reading_time].filter(Boolean).join(" · ");
---
<Page title={p.data.title} description={p.data.excerpt ?? summarize(p.body)} crumbs={[{ label: "Writing", href: "/writing/" }, ...(p.data.category ? [{ label: p.data.category, href: "/writing/" }] : [])]} local={false}>
  <Fragment slot="aside">
    <dl>
      <dt>Published</dt><dd>{fmtDate(p.data.date, { day: "numeric", month: "long", year: "numeric" })}</dd>
      {authors.length > 0 && <><dt>By</dt><dd>{authors.map((a) => a!.data.name).join(", ")}</dd></>}
      {p.data.reading_time && <><dt>Reading time</dt><dd>{p.data.reading_time.replace(/^~/, "about ")}</dd></>}
      {p.data.category && <><dt>Category</dt><dd><a href={`/writing/?cat=${encodeURIComponent(p.data.category)}`}>{p.data.category}</a></dd></>}
      {p.data.tags.length > 0 && <><dt>Topics</dt><dd>{p.data.tags.join(", ")}</dd></>}
    </dl>
    <a class="btn ghost" href="/writing/">All writing</a>
  </Fragment>
  <Fragment set:html={body} />
  <nav class="block" style="padding-top:40px" aria-label="More writing">
    {older && <a class="page-link" href={`/writing/${older.id}/`}><span class="ic" aria-hidden="true">←</span>{older.data.title}</a>}
    {newer && <a class="page-link" href={`/writing/${newer.id}/`}><span class="ic" aria-hidden="true">→</span>{newer.data.title}</a>}
    <a class="page-link" href="/writing/">All writing</a>
  </nav>
</Page>
