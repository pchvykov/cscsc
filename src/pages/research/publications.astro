---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import { fmtDate } from "../../lib/text";
const pubs = (await getCollection("publications")).sort((a, b) => +b.data.date - +a.data.date);
const label = { proceedings: "Proceedings", report: "Report", paper: "Paper", preprint: "Preprint", essay: "Essay" };
---
<Page title="Publications" dek="Proceedings and reports from our gatherings, and papers by the community.">
  <h2 class="visually-hidden">All publications</h2>
  <ul class="rows">
    {pubs.map((p) => (
      <li><div class="when"><b>{label[p.data.kind]}</b>{fmtDate(p.data.date)}</div>
      <div><h3><a href={p.data.href}>{p.data.title}</a></h3>{p.data.summary && <p>{p.data.summary}</p>}{p.data.authors && <p style="font-size:.85rem">{p.data.authors}</p>}</div></li>
    ))}
  </ul>
  <p class="muted" style="margin-top:28px">The Honest Science proceedings are in preparation and will appear here.</p>
</Page>
