---
import Page from "../layouts/Page.astro";
import { links } from "../data/site";
---
<Page title="Join" dek="Physicists, biologists, cognitive scientists, philosophers and contemplative practitioners. Help build the scientific culture we wish existed." local={false} wide>
  <div class="join-grid">
    <article class="join-card">
      <span class="k">Stay in touch</span>
      <h2>Email updates</h2>
      <p>Updates on our online discussions and events, conferences, publications, and research opportunities.</p>
      <a class="btn solid" href={links.emailSignup}>Add your email</a>
    </article>
    <article class="join-card">
      <span class="k">Any time</span>
      <h2>The forum</h2>
      <p>Our Hylo community forum, for research discussions, sharing related events, organizing local meetups (using a geographic map of members).</p>
      <a class="btn ghost" href={links.forum}>Join the forum</a>
    </article>
    <article class="join-card">
      <span class="k">Monthly, online</span>
      <h2>Calls and reading groups</h2>
      <p>A monthly call, open to anyone curious, and reading groups that come and go. Dates go out by email.</p>
      <a class="btn ghost" href="/gatherings/calls/">Calls and reading groups</a>
      <p style="margin-top:10px"><a href={links.calendar}>Calendar on Hylo →</a> <span class="muted">(join the forum first)</span></p>
    </article>
  </div>

  <section class="block prose">
    <h2>Taking part more</h2>
    <p>Write for the blog: see <a href="/writing/#contribute">contributing to the blog</a>. To host a call, propose a reading group or a working group, or bring us to your institution, <a href="#" class="mail" data-u="cscs.conference" data-d="gmail.com">write to us</a>.</p>
  </section>
</Page>
<style>
  .join-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
  .join-card { padding: 26px; border: 1px solid var(--rule-soft); border-radius: 10px; background: var(--bg-raised); display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .join-card h2 { font-size: 1.7rem; }
  .join-card p { margin: 0; color: var(--muted); }
  .join-card .btn { margin-top: auto; }
</style>
