---
import { getCollection, getEntry, render } from "astro:content";
import Page from "../../layouts/Page.astro";
import { fmtDate } from "../../lib/text";

const posts = (await getCollection("posts", (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const people = await getCollection("people");
const nameOf = (id: string) => people.find((p) => p.id === id)?.data.name ?? id;
const cats = [...new Set(posts.map((p) => p.data.category).filter(Boolean))] as string[];
const hub = await getEntry("pages", "blog/_hub");
const Hub = hub ? (await render(hub)).Content : null;
---
<Page title="Blog" dek="Updates from our conferences, reflections on key questions in the field, and write-ups of community calls." wide local={false}>
  <h2 class="visually-hidden">All posts</h2>
  <div class="dv-bar" data-filter-root>
    <div class="dv-filters" role="group" aria-label="Filter by category">
      <button type="button" aria-pressed="true" data-cat="">All</button>
      {cats.map((c) => <button type="button" aria-pressed="false" data-cat={c}>{c}</button>)}
    </div>
    <span class="dv-count" data-count>{posts.length} posts</span>
  </div>
  <div class="cards blog-cards" id="post-list">
    {posts.map((p) => (
      <a class="card" href={`/blog/${p.id}/`} data-cat={p.data.category ?? ""}>
        {p.data.image && <div class="thumb"><img src={p.data.image} alt="" loading="lazy" /></div>}
        <span class="k">{p.data.category ?? "Post"} · {fmtDate(p.data.date)}</span>
        <h3>{p.data.title}</h3>
        {p.data.excerpt && <p>{p.data.excerpt}</p>}
        {p.data.authors.length > 0 && <p class="by">{p.data.authors.map(nameOf).join(", ")}{p.data.reading_time && ` · ${p.data.reading_time}`}</p>}
      </a>
    ))}
  </div>
  {Hub && <section class="block prose" id="contribute"><Hub /></section>}
</Page>
<script>
  const root = document.querySelector("[data-filter-root]")!;
  const items = [...document.querySelectorAll<HTMLElement>("#post-list > .card")];
  const count = root.querySelector("[data-count]")!;
  root.querySelectorAll<HTMLButtonElement>("button[data-cat]").forEach((b) => b.addEventListener("click", () => {
    root.querySelectorAll("button[data-cat]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    let n = 0;
    items.forEach((li) => { const show = !b.dataset.cat || li.dataset.cat === b.dataset.cat; li.hidden = !show; if (show) n++; });
    count.textContent = `${n} post${n === 1 ? "" : "s"}`;
  }));
  const want = new URLSearchParams(location.search).get("cat");
  if (want) root.querySelector<HTMLButtonElement>(`button[data-cat="${CSS.escape(want)}"]`)?.click();
</script>
