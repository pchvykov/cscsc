---
import { getCollection, render } from "astro:content";
import Page from "../../../layouts/Page.astro";
import { RES, KINDS } from "../../../lib/resources";

export async function getStaticPaths() {
  const out = [];
  for (const kind of KINDS) for (const e of await getCollection(kind)) out.push({ params: { kind, slug: e.id }, props: { e, kind } });
  return out;
}
const { e, kind } = Astro.props;
const cfg = RES[kind as keyof typeof RES];
const d = e.data as Record<string, any>;
const { Content } = await render(e);
const fmt = (v: any) => Array.isArray(v) ? v.join(", ") : String(v);
const rows = cfg.fields.filter(([k]) => d[k] !== undefined && d[k] !== null && !(Array.isArray(d[k]) && d[k].length === 0));
---
<Page title={d.title} crumbs={[{ label: "Resources", href: "/resources/" }, { label: cfg.title, href: `/resources/${kind}/` }]} local={false}>
  {d.website && <p><a class="btn ghost" href={d.website}>Visit website →</a></p>}
  <dl class="props">
    {rows.map(([k, label]) => <><dt>{label}</dt><dd>{fmt(d[k])}</dd></>)}
  </dl>
  <Content />
  <p><a href={`/resources/${kind}/`}>← All {cfg.noun}</a></p>
</Page>
