---
import { getCollection, render } from "astro:content";
import Page from "../../layouts/Page.astro";
import { kindOf, when } from "../../lib/events";
import { fmtDate, summarize } from "../../lib/text";
import DateSwitch from "../../components/DateSwitch.astro";
import { enhance } from "../../lib/enhance";
import { iso, buildDay } from "../../lib/dates";

export async function getStaticPaths() {
  return (await getCollection("events")).map((e) => ({ params: { slug: e.id }, props: { e } }));
}
const { e } = Astro.props;
const endDay0 = iso(e.data.end_date ?? e.data.date);
// Prices, sign-ups and registration are wrapped in .until-end in the event file; they disappear once the event is over.
const body = enhance(e.rendered?.html ?? "", { mapHeadings: true }).html
  .replace(/class="until-end"/g, `class="until-end" data-until="${endDay0}"${endDay0 < buildDay ? " hidden" : ""}`);
const emptyBody = !body.replace(/<[^>]+>/g, "").trim();
const videos = (await getCollection("videos", (v) => v.data.event === e.id)).sort((a, b) => +a.data.date - +b.data.date);
const oneKind = new Set(videos.map((v) => v.data.kind)).size === 1;
const pubs = await getCollection("publications", (p) => p.data.event === e.id);
const endDay = iso(e.data.end_date ?? e.data.date);
const subpages = (await getCollection("pages", (p) => p.data.path.startsWith(`/gatherings/${e.id}/`))).sort((a, b) => a.data.path.localeCompare(b.data.path));
---
<Page title={e.data.title} docTitle={e.data.featured ? e.data.title : `${e.data.title}, ${fmtDate(e.data.date)}`} cover={e.data.cover} description={e.data.summary ?? summarize(e.body)} image={e.data.image ?? e.data.cover} crumbs={[{ label: "Gatherings", href: "/gatherings/" }]} dek={emptyBody ? e.data.summary : undefined}
  local={false}>
  {!emptyBody && <Fragment slot="aside">
    <dl>
      <dt>When</dt><dd>{when(e)}</dd>
      {e.data.place && <><dt>Where</dt><dd>{e.data.place}</dd></>}
      <dt>Kind</dt><dd>{kindOf(e)}</dd>
      {subpages.length > 0 && <><dt>Pages</dt><dd><ul>{subpages.map((p) => <li><a href={p.data.path}>{p.data.title}</a></li>)}</ul></dd></>}
      {videos.length > 0 && <><dt>Recordings</dt><dd><a href="#recordings">{videos.length} video{videos.length > 1 ? "s" : ""}</a></dd></>}
      {pubs.length > 0 && <><dt>Outputs</dt><dd><ul>{pubs.map((p) => <li><a href={p.data.href}>{p.data.title}</a></li>)}</ul></dd></>}
    </dl>
    <a class="btn ghost" href="/gatherings/">All gatherings</a>
  </Fragment>}
  {emptyBody && (
    <dl class="props">
      <dt>When</dt><dd>{when(e)}</dd>
      {e.data.place && <><dt>Where</dt><dd>{e.data.place}</dd></>}
      <dt>Kind</dt><dd>{kindOf(e)}</dd>
    </dl>
  )}
  {!emptyBody && e.id !== "cscsc25" && (
    <aside class="note" data-after={endDay} hidden={endDay >= buildDay}><div>
      <p><b>This {e.data.featured ? "gathering" : kindOf(e).toLowerCase()} took place {when(e)}.</b> The page below is the original {e.data.featured ? "invitation" : "announcement"}, kept as a record.
      {videos.length > 0 && <> <a href="#recordings">Recordings</a></>}{pubs.length > 0 && <> · <a href="#outputs">Outputs</a></>}</p>
    </div></aside>
  )}
  <Fragment set:html={body} />
  {pubs.length > 0 && (
    <section id="outputs" class="block" style="padding-top:40px">
      <h2>Outputs</h2>
      {pubs.map((p) => <a class="page-link" href={p.data.href}>{p.data.title}</a>)}
    </section>
  )}
  {videos.length > 0 && (
    <section id="recordings" class="block" style="padding-top:40px">
      <h2>Recordings</h2>
      <ul class="rows">
        {videos.map((v) => (
          <li><div class="when">{!oneKind && <b>{v.data.kind}</b>}{v.data.duration}</div>
          <div><h3><a href={`https://www.youtube.com/watch?v=${v.data.youtube}`}>{v.data.title}</a></h3></div></li>
        ))}
      </ul>
    </section>
  )}
  <DateSwitch />
</Page>
