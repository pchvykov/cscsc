---
import Page from "../../layouts/Page.astro";
import { allEvents, kindOf, when } from "../../lib/events";
import { getCollection } from "astro:content";
import { links } from "../../data/site";
import DateSwitch from "../../components/DateSwitch.astro";
import { iso, buildDay } from "../../lib/dates";

const { evs, upcoming } = await allEvents();
const endOf = (e: (typeof evs)[number]) => iso(e.data.end_date ?? e.data.date);
const isSeries = (t: string[]) => t.includes("call") || t.length === 0;
const nextCalls = upcoming.filter((e) => e.data.tags.includes("call"));
const pastCalls = [...evs].sort((a, b) => +b.data.date - +a.data.date).filter((e) => !e.data.featured && !e.data.tags.includes("conference") && !e.data.tags.includes("retreat") && !e.data.tags.includes("external"));
const oneKind = (list: typeof evs) => new Set(list.map(kindOf)).size === 1;
const recs = (await getCollection("videos", (v) => v.data.kind === "recording")).sort((a, b) => +b.data.date - +a.data.date);
---
<Page title="Calls and reading groups" dek="A monthly call, open to anyone curious, and reading groups that come and go." section="Gatherings">
  <p>Dates for calls and events are announced by email. <a class="btn solid" href={links.emailSignup} style="margin-left:6px">Get updates by email</a></p>
  <p class="muted" style="font-size:.85rem">Forum members can also see a <a href={links.calendar}>calendar on Hylo</a>, though it is not always up to date.</p>
  {nextCalls.length > 0 && (<section data-hide-empty="next-calls" hidden={!nextCalls.some((e) => endOf(e) >= buildDay)}>
    <h2>Coming up</h2>
    <ul class="rows" id="next-calls">{nextCalls.map((e) => <li data-until={endOf(e)} hidden={endOf(e) < buildDay}><div class="when">{!oneKind(nextCalls) && <b>{kindOf(e)}</b>}{when(e)}</div><div><h3><a href={`/gatherings/${e.id}/`}>{e.data.title}</a></h3>{e.data.summary && <p>{e.data.summary}</p>}</div></li>)}</ul>
  </section>)}
  <h2>Reading groups</h2>
  <a class="page-link" href="/gatherings/embodied-conversations/">Embodied Conversations: how the sessions run</a>
  <h2>Recordings</h2>
  <ul class="rows">{recs.map((v) => <li><div class="when">{when({ data: { date: v.data.date } } as any)}</div><div><h3><a href={`https://www.youtube.com/watch?v=${v.data.youtube}`}>{v.data.title}</a></h3></div></li>)}</ul>
  <h2>Past calls and groups</h2>
  <ul class="rows">{pastCalls.map((e) => <li data-after={endOf(e)} hidden={endOf(e) >= buildDay}><div class="when">{!oneKind(pastCalls) && <b>{kindOf(e)}</b>}{when(e)}</div><div><h3><a href={`/gatherings/${e.id}/`}>{e.data.title}</a></h3>{e.data.summary && <p>{e.data.summary}</p>}</div></li>)}</ul>
  <DateSwitch />
</Page>
