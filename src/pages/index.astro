---
// Home page: prototype F. "Latest" is built from the events, posts and
// publications collections at build time.
import "../styles/home.css";
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { links } from "../data/site";
import { fmtDate } from "../lib/text";

const today = new Date(new Date().toISOString().slice(0, 10)); // start of today, UTC
const cutoff = new Date(today.getTime() - 1000 * 60 * 60 * 24 * 120);
const events = (await getCollection("events")).map((e) => ({
  date: e.data.date, end: e.data.end_date, label: e.data.tags.includes("call") ? "Community call" : e.data.tags.includes("retreat") ? "Retreat" : e.data.tags.includes("conference") ? "Conference" : "Gathering",
  title: e.data.title, blurb: e.data.summary ?? "", href: `/gatherings/${e.id}/`, featured: e.data.featured,
}));
const posts = (await getCollection("posts", (p) => !p.data.draft)).map((p) => ({
  date: p.data.date, end: undefined, label: "Writing", title: p.data.title, blurb: p.data.excerpt ?? "", href: `/writing/${p.id}/`, featured: false,
}));
const pubs = (await getCollection("publications")).map((p) => ({
  date: p.data.date, end: undefined, label: p.data.kind === "proceedings" ? "Proceedings" : "Publication", title: p.data.title, blurb: p.data.summary ?? "", href: p.data.href, featured: true,
}));
const all = [...events, ...posts, ...pubs];
const iso = (d: Date) => d.toISOString().slice(0, 10);
// Candidates for "Latest": anything from the last 120 days or still to come.
// The list is computed here for the build date, and recomputed in the browser
// on load (script at the bottom), so it stays current between deploys.
const pool = all.filter((x) => x.date >= cutoff).sort((a, b) => +b.date - +a.date).map((x) => ({ ...x, d: iso(x.date), e: iso(x.end ?? x.date) }));
const t0 = iso(today);
const upcoming = pool.filter((x) => x.e >= t0).sort((a, b) => a.d.localeCompare(b.d)).slice(0, 1);
const recent = pool.filter((x) => x.e < t0);
const shown = new Set([...upcoming, ...recent].slice(0, 4));
const latest = pool.map((x) => ({ ...x, next: upcoming.includes(x), on: shown.has(x) }));
---
<Base>
  <section class="hero">
    <div class="wrap">
      <figure class="hero-mark" style="margin:0">
        <span class="tile big"><span class="draw"><span class="enso big-enso" role="img" aria-label="Ensō, a brush-drawn circle"></span></span></span>
        <figcaption><a href="#why" style="text-decoration:none">Everything arises from relations.</a></figcaption>
      </figure>
      <div class="copy">
        <h1><span>Complexity Science &amp;</span> <span>Contemplative Studies</span> <span>Consortium</span></h1>
        <p class="sub">Complexity science helps us understand what contemplatives explore: what a &lsquo;self&rsquo; is, and how attention shapes what we see. Contemplative practice helps us transform how science itself is done.</p>
        <div class="actions">
          <a class="btn solid" href="/join/">Join us</a>
          <a class="btn ghost" href="/vision/"><span class="play" aria-hidden="true"></span>Our vision · 3-min animation</a>
        </div>
        <div class="credits" aria-label="Past speakers, advisors and organizers">
          <p><span class="k">Some past speakers</span><span class="names"><span class="nm">Michael Levin <i>Tufts</i></span><span class="nm">Neil Theise <i>NYU</i></span><span class="nm">Gary Lupyan <i>UW-Madison</i></span><span class="nm">Adam Safron <i>Tufts</i></span><span class="nm">Chaitanya Gokhale <i>Würzburg</i></span><span class="nm">Alan Rodrigues <i>Rockefeller</i></span><span class="nm">Marc Santolini <i>Learning Planet Institute</i></span></span></p>
          <p><span class="k">Advisors</span><span class="names"><span class="nm">John Dunne <i>UW-Madison</i></span><span class="nm">Francis Heylighen <i>VUB</i></span></span></p>
          <p><span class="k">Organizers</span><span class="names"><span class="nm">Pavel Chvykov <i>IGDORE</i></span><span class="nm">Matthew McCarthy <i>VUB</i></span><span class="nm">Matthieu Barbier <i>INTP</i></span><span class="nm">Robert Marsland <i>Pontifical University of the Holy Cross</i></span></span></p>
          <p class="founded"><span class="k">Founded</span><span class="names">October 2025</span></p>
          </div>
      </div>
    </div>
  </section>



  <section class="wrap" id="what" aria-labelledby="what-h">
    <div class="section-head"><h2 id="what-h">What we do</h2></div>
    <p class="lead">Contemplative traditions suggest the hypotheses. Complexity science looks for the mechanisms. We keep ourselves honest by practicing what we study.</p>
    <div class="doing">
      <a href="/research/">
        <div class="thumb" style="background: #ede5d4"><img src="/assets/research-map.webp" style="object-fit: contain; background: transparent; mix-blend-mode: multiply" alt="Diagram from the Honest Science proceedings: world, self and others, linked by knowing and acting" loading="lazy" /></div>
        <span class="verb">Research</span>
        <h3>How life can know itself</h3>
        <p>We develop formal theory bridging contemplative insight with complexity science, through Bayesian models of meditation, the agency of collective imaginaries, and the relational construction of reality.</p>
        <span class="more">Research directions →</span>
      </a>
      <a href="/gatherings/">
        <div class="thumb"><img src="/assets/talk.webp" alt="A talk in a wood-beamed hall, participants seated informally" loading="lazy" /></div>
        <span class="verb">Gatherings</span>
        <h3>Meetings for better questions</h3>
        <p>Week-long retreats, conference sessions, and online gatherings, where we design how we meet as carefully as what we discuss: contemplative settling, silence, movement, and honestly bringing the research that lights us up.</p>
        <span class="more">Upcoming and past →</span>
      </a>
      <a href="/videos/">
        <div class="thumb labelled"><img src="/assets/hs-title.webp" alt="Title card of the film Honest Science: science that includes the scientist" loading="lazy" /><span class="chip"><span class="tri" aria-hidden="true"></span>Trailer · 4 min</span></div>
        <span class="verb">Tools &amp; media</span>
        <h3>Usable materials:</h3>
        <p>Proceedings, essays, recorded talks, short edited films, an episteme-diagnosis questionnaire... Tested practices others can adopt: a facilitated co-working practice and guidance app.</p>
        <span class="more">Tools and media →</span>
      </a>
    </div>
  </section>

  <section class="wrap" aria-labelledby="room-h">
    <div class="section-head"><div><h2 id="room-h">From the room</h2><p class="muted" style="margin:6px 0 0;font-size:.92rem">What changes when a meeting is designed differently</p></div>
      <div class="qnav"><span class="qcount" aria-live="polite">1 / 5</span><button class="qprev" type="button" aria-label="Previous quote">‹</button><button class="qnext" type="button" aria-label="Next quote">›</button></div></div>
    <div class="quotes" aria-roledescription="carousel" aria-label="Quotes from participants">
      <div class="qtrack">
        <blockquote class="q"><p>&ldquo;I feel calm, unlike most conference days.&rdquo;</p><footer><b>Participant</b> · CCS26 satellite, Binghamton</footer></blockquote>
        <blockquote class="q"><p>&ldquo;Normally these conversations between science and religious studies… everyone is speaking in the voice of a straw man. This week we actually had an extremely coherent, consistent, shared language.&rdquo;</p><footer><b>Jordan Borgman</b> · religious studies</footer></blockquote>
        <blockquote class="q"><p>&ldquo;Something in the slowing down, paying attention, allowed me to have… a gap… and go deeper. It was both more productive and… the quality was better.&rdquo;</p><footer><b>Tomer Mizrav</b> · anthropology</footer></blockquote>
        <blockquote class="q"><p>&ldquo;You can really feel that you're bringing your whole self and not just your facade as a scientist or a professional… I've had that experience in other group settings, but not among academics and scientists.&rdquo;</p><footer><b>Lana Frankle</b> · neuroscience</footer></blockquote>
        <blockquote class="q"><p>&ldquo;Why don't we do research as we do music together, or as we do sports?&rdquo;</p><footer><b>Matthieu Barbier</b> · physics, theoretical ecology</footer></blockquote>
        <blockquote class="q"><p>&ldquo;I'm an extrovert. I don't believe how much I enjoyed the quiet.&rdquo;</p><footer><b>Veronica Frans</b> · ecology</footer></blockquote>
      </div>
    </div>
  </section>

  <section class="wrap" aria-labelledby="latest-h">
    <div class="section-head"><h2 id="latest-h">Latest</h2><a href="/gatherings/">All gatherings and outputs →</a></div>
    <ul class="latest" id="latest">
      {latest.map((x) => (
        <li class={x.next ? "next" : undefined} hidden={!x.on} data-d={x.d} data-e={x.e}>
          <div class="when"><b><span class="nx" hidden={!x.next}>Next · </span>{x.label}</b>{fmtDate(x.date)}</div>
          <div><h3><a href={x.href}>{x.title}</a></h3>{x.blurb && <p>{x.blurb}</p>}</div>
        </li>
      ))}
    </ul>
  </section>


  <section class="wrap" aria-labelledby="who-h">
    <div class="section-head"><h2 id="who-h">People</h2><a href="/about/people/">People and advisors →</a></div>
    <div class="people">
      <figure class="carousel" aria-roledescription="carousel" aria-label="Photos from our gatherings">
        <div class="frame">
          <img src="/assets/group.webp" alt="Honest Science participants, French Pyrenees, 2026" style="object-position:50% 50%" class="on" />
          <img src="/assets/chalk2.webp" alt="Alan Rodrigues, keynote at the CCS26 satellite, Binghamton NY, October 2026" style="object-position:35% 60%" />
          <img src="/assets/hillside.webp" alt="A discussion on the hillside above INTP, Honest Science, 2026" style="object-position:50% 45%" />
          <img src="/assets/c-lunch.webp" alt="Lunch on the terrace, Honest Science, 2026" style="object-position:50% 40%" />
          <img src="/assets/s-qigong.webp" alt="Morning practice in the forest, INTP retreat, 2025" style="object-position:50% 45%" />
          <img src="/assets/c-fire.webp" alt="Last evening, Honest Science, 2026" style="object-position:50% 50%" />
          <button class="arrow prev" type="button" aria-label="Previous photo">‹</button>
          <button class="arrow next" type="button" aria-label="Next photo">›</button>
        </div>
        <div class="under"><figcaption>Honest Science participants, French Pyrenees, 2026</figcaption><div class="dots"><button type="button" aria-label="Photo 1" aria-current="true"></button><button type="button" aria-label="Photo 2"></button><button type="button" aria-label="Photo 3"></button><button type="button" aria-label="Photo 4"></button><button type="button" aria-label="Photo 5"></button><button type="button" aria-label="Photo 6"></button></div></div>
      </figure>
      <div>
        <p>Physicists, biologists, cognitive scientists, philosophers and contemplative practitioners. The community is run by volunteers and is still young: its shape is being worked out in public.</p>
        <p class="story">Kicked off with an online conference in October 2025: 47 researchers from more than 30 institutions, three days on what complexity science and contemplative traditions have to say to each other. In September 2026 we spent two weeks in the French Pyrenees: Honest Science, on a science that includes the scientist and the real questions beneath our work, then the Work Alive retreat on working as practice. In October we held a satellite meeting at the Conference on Complex Systems in New York, on how we can study systems where the observer is inseparable from the system itself. Between gatherings we meet online: monthly community calls and reading groups where the discussion itself is approached as a contemplative practice, opening in silence and listening in open awareness.</p>
        <p class="partners">With <a href="https://intp.science">INTP</a>, a research institute in the Pyrenees, and the <a href="https://ccs26.cssociety.org/">Conference on Complex Systems</a></p>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="why" id="why">
      <span class="tile"><span class="enso" aria-hidden="true"></span></span>
      <div>
        <h2>Why an ensō?</h2>
        <p>Before it gave rise to the invention of zero, this brush-drawn circle stood for emptiness: in Buddhist thought, nothing exists in and of itself, everything arises from relations. Complexity science studies how structure and intelligence emerge from such relations. The circle also points to silence as where understanding starts; every theory after that is a useful, yet incomplete, model.</p>
        <a href="/vision/">New to all this? Start with the vision, an animated introduction →</a>
      </div>
    </div>
  </div>

  <section class="join-sec" id="join" aria-labelledby="join-h">
    <div class="wrap">
      <h2 id="join-h">Help build the scientific culture we wish existed</h2>
      <div>
        <ul>
          <li>Email updates: calls, gatherings, new talks and writing, research and funding openings</li>
          <li>A monthly call, open to anyone curious</li>
          <li>A forum with a member map</li>
        </ul>
        <div class="actions"><a class="btn solid" href={links.emailSignup}>Get updates by email</a><a class="btn ghost" href={links.forum}>Join the forum</a></div>
      </div>
    </div>
  </section>
<script is:inline>
  // Latest: the next upcoming item first, then the most recent past items
  // (last 120 days), four in all. Same rule as the build, using today's date.
  (() => {
    const d = new Date(), pad = (n) => String(n).padStart(2, "0");
    const t = d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
    const c = new Date(d.getTime() - 120 * 864e5), cut = c.getFullYear() + "-" + pad(c.getMonth() + 1) + "-" + pad(c.getDate());
    const items = [...document.querySelectorAll("#latest > li")];
    const up = items.filter((li) => li.dataset.e >= t).sort((a, b) => a.dataset.d.localeCompare(b.dataset.d)).slice(0, 1);
    const past = items.filter((li) => li.dataset.e < t && li.dataset.d >= cut);
    const show = [...up, ...past].slice(0, 4);
    items.forEach((li) => { li.hidden = !show.includes(li); li.classList.toggle("next", up.includes(li)); li.querySelector(".nx").hidden = !up.includes(li); });
    if (up[0]) up[0].parentElement.prepend(up[0]);
  })();
  // Quotes: two visible (one on phones), step one at a time every 12 s.
  // Pauses on hover and keyboard focus; wraps to the start with a fade.
  (() => {
    const box = document.querySelector(".quotes"); if (!box) return;
    const track = box.querySelector(".qtrack"), qs = [...track.children], count = document.querySelector(".qcount");
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let i = 0, timer = null, hover = false, focus = false;
    const per = () => (matchMedia("(max-width: 760px)").matches ? 1 : 2);
    const place = () => { track.style.transform = `translateX(${-(qs[i].offsetLeft - qs[0].offsetLeft)}px)`; count.textContent = `${i + 1} / ${qs.length - per() + 1}`; };
    const go = (n) => {
      const max = qs.length - per();
      if (n > max || n < 0) {
        track.style.opacity = 0;
        setTimeout(() => { track.style.transition = "none"; i = n > max ? 0 : max; place(); track.offsetHeight; track.style.transition = ""; track.style.opacity = 1; }, 450);
      } else { i = n; place(); }
    };
    const sync = () => { clearInterval(timer); if (!still && !hover && !focus) timer = setInterval(() => go(i + 1), 12000); };
    document.querySelector(".qprev").addEventListener("click", () => { go(i - 1); sync(); });
    document.querySelector(".qnext").addEventListener("click", () => { go(i + 1); sync(); });
    box.addEventListener("mouseenter", () => { hover = true; sync(); });
    box.addEventListener("mouseleave", () => { hover = false; sync(); });
    const nav = document.querySelector(".qnav");
    [box, nav].forEach((el) => {
      el.addEventListener("focusin", (e) => { if (e.target.matches(":focus-visible")) { focus = true; sync(); } });
      el.addEventListener("focusout", () => { focus = false; sync(); });
    });
    addEventListener("resize", place);
    place(); sync();
  })();
  // People carousel: arrows, dots, auto-advance every 6 s.
  // One timer only; it pauses while the pointer or keyboard focus is on the
  // carousel, and a click restarts the full 6 s count for the chosen photo.
  (() => {
    const c = document.querySelector(".carousel"); if (!c) return;
    const imgs = [...c.querySelectorAll("img")], dots = [...c.querySelectorAll(".dots button")], cap = c.querySelector("figcaption");
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let i = 0, timer = null, hover = false, focus = false;
    const show = (n) => {
      imgs[i].classList.remove("on"); dots[i].removeAttribute("aria-current");
      i = (n + imgs.length) % imgs.length;
      imgs[i].classList.add("on"); dots[i].setAttribute("aria-current", "true"); cap.textContent = imgs[i].alt;
    };
    const stop = () => { clearInterval(timer); timer = null; };
    const sync = () => { stop(); if (!still && !hover && !focus) timer = setInterval(() => show(i + 1), 6000); };
    c.querySelector(".prev").addEventListener("click", () => { show(i - 1); sync(); });
    c.querySelector(".next").addEventListener("click", () => { show(i + 1); sync(); });
    dots.forEach((d, n) => d.addEventListener("click", () => { show(n); sync(); }));
    c.addEventListener("mouseenter", () => { hover = true; sync(); });
    c.addEventListener("mouseleave", () => { hover = false; sync(); });
    c.addEventListener("focusin", (e) => { if (e.target.matches(":focus-visible")) { focus = true; sync(); } });
    c.addEventListener("focusout", (e) => { if (!c.contains(e.relatedTarget)) { focus = false; sync(); } });
    sync();
  })();
</script>
</Base>
